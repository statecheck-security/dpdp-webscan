{
  "name": "dpdp-webscan",
  "version": "0.0.0",
  "description": "DPDPA Website Check engine: loads a public site in headless Chromium and reports what it does before visitors choose, mapped to the DPDP Act and Rules. No score.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scan": "tsx src/cli.ts",
    "scan:docker": "docker compose -f docker/compose.yml run --build --rm scan",
    "scan:docker:selftest": "docker compose -f docker/compose.yml run --build --rm selftest",
    "scan:send": "tsx src/send.ts",
    "browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"test/**/*.browser.test.ts\"",
    "test:browser": "vitest run browser.test --passWithNoTests",
    "lint": "tsc --noEmit && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
